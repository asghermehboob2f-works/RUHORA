# Environment Configuration
NODE_ENV="development"

# Database connection (PostgreSQL in production, SQLite or PostgreSQL for local dev)
DATABASE_URL="file:./dev.db"

# Site Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin Authentication Secret
ADMIN_SECRET_KEY="ruhora-ultra-secure-development-secret-key-replace-in-prod"

# Optional Cloud Storage (Cloudflare R2 / AWS S3)
# S3_BUCKET_NAME=""
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Optional Upstash Redis for Rate Limiting
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Optional Email Provider (Resend)
# RESEND_API_KEY=""
